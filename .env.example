# Copy to .env and fill in. Comments sit on their own line: `docker run --env-file` and some other loaders keep
# anything after the = (including a trailing # comment) as part of the value.

# ── Core ─────────────────────────────────────────────
# development | test | staging | production
APP_ENV=development
# production: https://your-domain (http is refused)
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gympulse
# tests run in this schema of DATABASE_URL (tests/setup/env.ts)
TEST_DB_SCHEMA=gympulse_test
DB_POOL_SIZE=10

# ── Secrets: generate fresh per environment, never reuse ──
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# openssl rand -base64 32
FILE_ENCRYPTION_KEY=
# openssl rand -base64 48
SIGNING_SECRET=

# ── Files / worker ───────────────────────────────────
STORAGE_DIR=./.storage
RUN_WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=2
MAX_UPLOAD_MB=10
# tesseract | none
OCR_PROVIDER=none
TESSERACT_LANG_PATH=
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Security switches ────────────────────────────────
# must be false in production
ALLOW_ADMIN_WITHOUT_MFA=false
# must be false in production
ENABLE_TEST_GATEWAY=false
# Number of reverse proxies in front (1 for a single Caddy/nginx). Production requires it set explicitly.
# 0 = no proxy, X-Forwarded-For ignored: local development only, and all clients then share one per-IP
# rate-limit bucket.
TRUSTED_PROXY_HOPS=1

# ── Email / push / login ─────────────────────────────
# smtp | console | none (console refused in production)
EMAIL_TRANSPORT=none
# smtps://user:pass@smtp.provider.com:465
SMTP_URL=
EMAIL_FROM=GymPulse <no-reply@your-domain>
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Ops ──────────────────────────────────────────────
# leave commented when unused: an empty value fails the URL check and the app won't boot
# ERROR_WEBHOOK_URL=https://...
LOG_LEVEL=info

  count       Int
  windowStart DateTime
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  gymId          String?
  status         JobStatus @default(PENDING)
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())

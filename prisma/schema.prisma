  @@index([type, status])
}

model MetricSample {
  id        String   @id @default(cuid())
  name      String
  value     Float
  tags      Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model StoredFile {
  id         String         @id @default(cuid())
  gymId      String?
  kind       StoredFileKind
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String?
  createdAt  DateTime       @default(now())
  gym        Gym?           @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SubscriptionInvoiceStatus {
  DUE
  PAID
  FAILED
  VOID
}

enum FlagScope {
  GLOBAL
  PLAN
  GYM
}

enum GymStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
  PHONE_VERIFY

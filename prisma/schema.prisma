  @@index([gymId])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorType String
  authorId   String?
  authorName String
  body       String
  internal   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  gymId      String?
  ip         String?
  userAgent  String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([gymId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model SecurityEvent {
  id        String    @id @default(cuid())
  type      String
  actorType ActorType
  userId    String?
  adminId   String?
  email     String?
  gymId     String?
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([ip, createdAt])
}

model RateLimitBucket {
